# Credentials for the live Kick pipeline check (npm run test:live -w @twitch-stats/e2e).
#
# Copy to e2e/.env and fill in the values. e2e/.env is gitignored.
# Nothing else needs credentials: the unit tests and `npm run test:e2e` run
# entirely against local containers.
#
# Each platform's section is optional and skipped if left blank, so you can
# check one without the other.

# https://kick.com/settings/developer -> create an app. The livestreams
# endpoint uses the client-credentials flow, so no redirect URL and no scopes
# are required.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# https://dev.twitch.tv/console/apps -> register an application. Helix
# GET /streams needs only an app access token, so again no redirect URL or
# scopes beyond the defaults.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
