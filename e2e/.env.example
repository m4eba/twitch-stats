# Credentials for the live Kick pipeline check (npm run test:live -w @twitch-stats/e2e).
#
# Copy to e2e/.env and fill in the values. e2e/.env is gitignored.
# Nothing else needs credentials: the unit tests and `npm run test:e2e` run
# entirely against local containers.
#
# Get these from https://kick.com/settings/developer -> create an app.
# The livestreams endpoint uses the client-credentials flow, so no redirect URL
# and no scopes are required.

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
